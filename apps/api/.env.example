# These variables are only used by the dormant hosted mode (apps/api +
# apps/workers). The default scout CLI + local viewer don't need any of
# this; see the root .env.example instead.

# ---- Database (pnpm hosted:docker:up) ----
DATABASE_URL=postgres://postgres:postgres@localhost:5432/integration_scout

# ---- Redis (pnpm hosted:docker:up) ----
REDIS_URL=redis://localhost:6379

# ---- OpenAI ----
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5.5
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
AI_PROVIDER=openai

# ---- Clerk ----
# Leave blank to run with a single unauthenticated dev user locally.
# NODE_ENV=production refuses to start without these set.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# ---- Service URLs ----
PORT=4000
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api
