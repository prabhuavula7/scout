# Used when running the scout CLI / local viewer from this monorepo
# (pnpm --filter @dotapk7/scoutcli dev, or `scout serve`). None of this is
# required if you're just installing the published @dotapk7/scoutcli
# package; `scout config llm add <kind> --api-key <key>` is the real,
# provider-agnostic path (openai, anthropic, azure-openai, openrouter,
# openai-compatible for local/self-hosted models), and persists to
# ~/.scout/config.json instead of an env var. See docs/quickstart.md.
#
# The env vars below are only a zero-config OpenAI-specific fallback, used
# solely when nothing has been configured via `scout config` yet; they're
# never written back to disk and don't apply to any other provider.

OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5.5
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Optional: same zero-config fallback for `scout research` (Tavily). For any
# other search provider, or to configure Tavily explicitly, use
# `scout config search add <kind> --api-key <key>` instead.
TAVILY_API_KEY=

# For the dormant hosted mode (apps/api, apps/workers) see apps/api/.env.example instead.
