# ---- Database (docker compose up -d) ----
DATABASE_URL=postgres://postgres:postgres@localhost:5432/integration_scout

# ---- Redis (docker compose up -d) ----
REDIS_URL=redis://localhost:6379

# ---- OpenAI ----
# Required for import understanding, doc embedding, and chat.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5.5
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
AI_PROVIDER=openai

# ---- Clerk (apps/web + apps/api) ----
# Leave blank to run with a single unauthenticated dev user locally.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# ---- Service URLs ----
PORT=4000
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api
