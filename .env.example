# Used when running the scout CLI / local viewer from this monorepo
# (pnpm --filter @dotapk7/scoutcli dev, or `scout serve`). None of this is
# required if you're just installing the published @dotapk7/scoutcli
# package; use `scout config set openai-api-key <key>` instead, which
# persists to ~/.scout/config.json.

# Required for scout understand / scout chat / scout watch / the local viewer's chat.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5.5
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
AI_PROVIDER=openai

# Optional: powers `scout research`, finding related articles/tutorials via Tavily.
TAVILY_API_KEY=

# For the dormant hosted mode (apps/api, apps/workers) see apps/api/.env.example instead.
