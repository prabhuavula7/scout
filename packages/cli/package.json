{
  "name": "scoutcli",
  "version": "1.1.0",
  "private": false,
  "description": "Understand any enterprise platform in minutes. Point Scout at an OpenAPI spec and docs, get an integration blueprint and a grounded chat assistant, all local.",
  "license": "MIT",
  "author": "Prabhu Avula",
  "homepage": "https://github.com/prabhuavula7/scout",
  "repository": {
    "type": "git",
    "url": "https://github.com/prabhuavula7/scout.git",
    "directory": "packages/cli"
  },
  "bugs": "https://github.com/prabhuavula7/scout/issues",
  "keywords": ["cli", "openapi", "swagger", "api", "integration", "documentation", "llm", "mcp"],
  "type": "module",
  "bin": {
    "scout": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "@modelcontextprotocol/sdk": "^1.11.0",
    "cheerio": "^1.0.0",
    "commander": "^13.1.0",
    "gpt-tokenizer": "^2.8.1",
    "minisearch": "^7.1.1",
    "next": "^15.1.3",
    "openai": "^4.77.0",
    "ora": "^8.1.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "turndown": "^7.2.0",
    "yaml": "^2.7.0",
    "zod": "^3.24.1",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@scout/agents": "workspace:*",
    "@scout/ai": "workspace:*",
    "@scout/connectors": "workspace:*",
    "@scout/store": "workspace:*",
    "@scout/types": "workspace:*",
    "@scout/typescript-config": "workspace:*",
    "@scout/web": "workspace:*",
    "@types/node": "^22.10.5",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
